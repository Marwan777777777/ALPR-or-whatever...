# ==============================================================================
# Egyptian Vehicle Intelligence System: Environment Configuration
# ==============================================================================
# Copy this file to .env and adjust variables for your local machine environment:
#   Copy-Item .env.example .env
#
# Note: .env is ignored by Git to prevent committing machine-specific paths or secrets.
# ==============================================================================

# Application Environment Mode ('development', 'staging', 'production')
VEHICLE_INTEL_ENVIRONMENT=development

# Logging Level ('DEBUG', 'INFO', 'WARNING', 'ERROR')
VEHICLE_INTEL_LOG_LEVEL=INFO
VEHICLE_INTEL_LOG_AS_JSON=false

# ------------------------------------------------------------------------------
# Data & Footage Paths (Configure if using external storage drives)
# ------------------------------------------------------------------------------
# Path to local gate camera footage or evaluation image captures
# Example Windows: C:/Data/TruckEntry or D:/TruckEntry
GATE_DIR=
# TRUCKENTRY_DIR=D:/TruckEntry

# Base directories for project storage
DATA_DIR=data
WEIGHTS_DIR=weights
ARTIFACTS_DIR=artifacts

# ------------------------------------------------------------------------------
# Hardware Execution & Compute Device
# ------------------------------------------------------------------------------
# Device options: 'cpu', 'cuda', 'cuda:0'
# By default, the system automatically uses CUDA if an NVIDIA GPU is available,
# falling back gracefully to CPU.
# VEHICLE_INTEL_DETECTOR__DEVICE=cuda:0
# VEHICLE_INTEL_OCR__DEVICE=cpu

# ------------------------------------------------------------------------------
# API Service Configuration (if running FastAPI server)
# ------------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
